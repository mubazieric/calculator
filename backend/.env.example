# Supply these to the server environment, never to the Android app.
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/iwat
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/play-service-account.json
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
ANDROID_PACKAGE=com.iwat.scientific
PLAY_SUBSCRIPTION_ID=iwat_ai_plus
MONTHLY_AI_LIMIT=50
